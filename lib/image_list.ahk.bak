strDOS =
for index, element in listOS {
	if SubStr(element[1], 0) != "/" {

	if index > 1
	{
		if pcheck = true
		{
			pcheck := false
		}
		else
		{
			strDOS .= ","
		}
	}
		strDOS .= "`n    """ waylistOS[element[4]] element[1] """"
	}
}
strDOS .= "`n]"

for index, element in prefixParametr {
	if index > 1
	{
		strOS .= ","
	}
	Else if !StartInc {
		strOS .= ","
	}
	strOS .= "`n""image_list" element """:[" strDOS
	StartInc := false
}